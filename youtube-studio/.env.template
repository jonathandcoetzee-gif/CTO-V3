# =============================================================================
# YouTube Studio — environment template
#
#   cp .env.template .env      then fill in every key marked REQUIRED.
#
# Every key is marked FREE or PAID. Nothing here is bought automatically:
# a PAID key only starts costing money once you create the account and paste it in.
# The n8n workflow refuses to run (with a message naming the key) until the
# REQUIRED ones are present, so a missing key can never look like a silent no-op.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM — script + SEO metadata
# -----------------------------------------------------------------------------
# REQUIRED | PAID: OpenAI pay-as-you-go, roughly $0.02-0.15 per video script.
# Get it: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# -----------------------------------------------------------------------------
# Voice — ElevenLabs
# -----------------------------------------------------------------------------
# REQUIRED | PAID: a paid plan is needed for commercial use (the free tier is
# 10k credits/month and requires "Powered by ElevenLabs" attribution).
# A 1,100-word video costs roughly 7k credits, so expect one video per month on
# the free tier and a Creator plan (from $22/month) for 3-5 videos/week.
# Get it: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# hook = synthesise only the opening line (cheap key/voice check, default)
# full = synthesise the whole script (full credit spend, gives a master narration file)
ELEVENLABS_NARRATION=hook

# REQUIRED | PAID voices, free to copy the ID.
# Copy each voice's ID from https://elevenlabs.io/app/voice-library — the four
# persona voices are named in channel-identity.md.
ELEVENLABS_VOICE_WEALTHMIND_AI=
ELEVENLABS_VOICE_GOLDENYEARS_GUIDE=
ELEVENLABS_VOICE_JUSTICE_TOLD=
ELEVENLABS_VOICE_FLUENTFAST_AI=

# -----------------------------------------------------------------------------
# Footage — Pexels
# -----------------------------------------------------------------------------
# REQUIRED | FREE (attribution required, 200 requests/hour).
# Get it: https://www.pexels.com/api/
PEXELS_API_KEY=

# -----------------------------------------------------------------------------
# Google Sheets — the ContentPipeline topic queue
# -----------------------------------------------------------------------------
# REQUIRED | FREE. The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

# -----------------------------------------------------------------------------
# YouTube — upload
# -----------------------------------------------------------------------------
# FREE: create an OAuth2 client in Google Cloud Console and authorise it inside
# n8n (Credentials -> YouTube OAuth2). The default YouTube Data API quota
# (10,000 units/day) covers about 6 uploads per day.
# These two are only needed if you create the OAuth client outside n8n.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# MoneyPrinterTurbo — render API (self-hosted, FREE)
# -----------------------------------------------------------------------------
# Inside the compose network n8n reaches the renderer by service name.
MPT_API_URL=http://moneyprinterturbo:8080
# Base URL MoneyPrinterTurbo puts in the download links it returns. It must be an
# address n8n can reach, so it is the compose service name, not localhost.
MPT_PUBLIC_URL=http://moneyprinterturbo:8080
# Optional shared secret; set the same value in config.toml via init-mpt-config.sh.
MPT_API_KEY=
# Polling guard: 60 polls x 20s = 20 minutes before the run fails loudly.
MPT_MAX_POLLS=60

# -----------------------------------------------------------------------------
# Run controls
# -----------------------------------------------------------------------------
# Videos per day (max 4 = one per channel, business-plan priority order).
MAX_VIDEOS_PER_RUN=4
TZ=UTC
